# Пароль PostgreSQL. Заполните для запуска Docker Compose
POSTGRES_PASSWORD=
HOST_PORT=8000

# Модерация через /admin. Задайте случайный токен для доступа
ADMIN_TOKEN=

# Для запуска Telegram заполните оба токена
BOT_TOKEN=
INTERNAL_API_TOKEN=
ADMIN_IDS=[]
WEBAPP_URL=

# Для подключения LLM укажите свой ключ
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Импорт стартового каталога при первом запуске
SEED_CONFIRMED_EVENTS=1

# Для развёртывания за HTTPS-прокси укажите адрес сайта
PUBLIC_BASE_URL=
# При пустом значении приложение сохраняет сгенерированный ключ в базе
SESSION_SECRET=
